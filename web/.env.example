# Zugangstokens für die Doku. Kommagetrennt, optional mit Label vor dem Doppelpunkt.
# Das Label erscheint in der Fußzeile der App und im Cookie — nie der Token selbst.
# Einen Token entfernen loggt genau dessen Nutzer sofort aus.
#
#   ACCESS_TOKENS="team:<langer-zufallstoken>,builder:<anderer-token>"
#
# Token erzeugen:  openssl rand -base64 32
ACCESS_TOKENS="team:CHANGE-ME"

# Signiert die Session-Cookies. Unbedingt setzen, sonst wird er aus den Tokens
# abgeleitet und jede Token-Änderung wirft alle aus der Sitzung.
#   openssl rand -base64 48
SESSION_SECRET="CHANGE-ME"

# Optional: Session-Dauer in Sekunden (Default 30 Tage)
# SESSION_MAX_AGE=2592000
